{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "mixedmodellint",
          "version": "test",
          "informationUri": "https://github.com/StevenACoffman/mixedmodellint",
          "rules": [
            {
              "id": "mml/parse-error",
              "name": "Source could not be read",
              "shortDescription": {
                "text": "mixedmodellint: Source could not be read"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "7.1-B",
              "name": "Grain and key consistency",
              "shortDescription": {
                "text": "§7.1: Grain and key consistency"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "5.1-A",
              "name": "Reserved-word and bare-type lexicon",
              "shortDescription": {
                "text": "§5.1: Reserved-word and bare-type lexicon"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "mml/parse-error",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "no position at all. Fix the syntax error, or exclude the file from the run. Entities in this statement were not checked."
          },
          "partialFingerprints": {
            "mixedmodellint/v1": "811449832854ab7c"
          }
        },
        {
          "ruleId": "mml/parse-error",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "syntax error at or near \"TABL\". Fix the syntax error, or exclude the file from the run. Entities in this statement were not checked."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "db/bad.sql"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "mixedmodellint/v1": "e1802a9a94c36fc1"
          }
        },
        {
          "ruleId": "mml/parse-error",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "file could not be read. Fix the syntax error, or exclude the file from the run. Entities in this statement were not checked."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "db/empty.sql"
                }
              }
            }
          ],
          "partialFingerprints": {
            "mixedmodellint/v1": "027f030c88a3798a"
          }
        },
        {
          "ruleId": "7.1-B",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "grain \"one row per order\" implies key (order_id), but order_lines has primary key (order_id, line_no). Correct the grain statement to match the key (the key implies \"one row per order line\"); or, if \"one row per order\" is what a row means, add UNIQUE (order_id)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "db/schema.sql"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ],
          "partialFingerprints": {
            "mixedmodellint/v1": "065e51f97be64299"
          }
        },
        {
          "ruleId": "5.1-A",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "column order_lines.date is a bare type word that does not say which event or value it holds. Rename date to say what it records, for example created_at, or <event>_at such as shipped_at."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "db/schema.sql"
                },
                "region": {
                  "startLine": 15,
                  "startColumn": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "mixedmodellint/v1": "8e436c3f73f65ab1"
          }
        },
        {
          "ruleId": "5.1-A",
          "ruleIndex": 2,
          "level": "note",
          "message": {
            "text": "column order_lines.kind is weakly ambiguous. Rename kind to say what it records, for example order_line_kind."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "db/schema.sql"
                },
                "region": {
                  "startLine": 16,
                  "startColumn": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "mixedmodellint/v1": "0f009a754b7d153d"
          }
        },
        {
          "ruleId": "5.1-A",
          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "column order_lines.amount is a generic name that does not say what is recorded. Rename amount to say what it records, for example order_line_amount."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "db/schema.sql"
                },
                "region": {
                  "startLine": 17,
                  "startColumn": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "mixedmodellint/v1": "2f3a4ccdde745298"
          }
        }
      ]
    }
  ]
}
